{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["@cloudflare/workers-types"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true
  },
  // Pulls in the shared wire schemas from the app, so the server validates with
  // exactly the definitions the clients use rather than a second copy.
  "include": ["src", "../src/sync/protocol.ts"]
}
